{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../../dist/types",
    "rootDir": "../../src",
    "baseUrl": "../..",
    "paths": {
      "@/*": ["src/*"],
      "@tests/*": ["src/__tests__/*"]
    },
    "types": []
  },
  "include": ["../../src/**/*.ts", "../../src/**/*.tsx"],
  "exclude": [
    "../../src/**/*.test.ts",
    "../../src/**/*.test.tsx",
    "../../src/**/*.spec.ts",
    "../../src/**/*.spec.tsx",
    "../../src/__tests__/**/*",
    "../../node_modules",
    "../../dist",
    "../../coverage"
  ]
}
