{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Assets-only Worker: no script, so every request is a static-asset request and
  // public/_headers and public/_redirects apply to all of them.
  "name": "safe-unfollow",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    // Vercel's `cleanUrls: true` + `trailingSlash: false`: /upload serves upload.html,
    // /upload/ and /upload.html redirect to /upload.
    "html_handling": "drop-trailing-slash",
    // Serves the nearest 404.html with a 404 status, as Vercel's static fallback did.
    "not_found_handling": "404-page",
  },
  // safeunfollow.app moved here from Vercel on 2026-10-30, as a zone route rather than a
  // custom domain: a custom domain cannot take over a hostname that already has a DNS
  // record without deleting it first, and a resolver asking in that gap caches the
  // absence. Instead the existing A record was switched to proxied, so the Worker
  // intercepts every request and the record's address (Vercel's) is never contacted.
  // Rollback is the same record back to DNS only. workers.dev stays on for branch
  // previews, which Cloudflare Access closes to account members; _headers marks it noindex.
  "routes": [{ "pattern": "safeunfollow.app/*", "zone_name": "safeunfollow.app" }],
  "workers_dev": true,
  "preview_urls": true,
  // Branch builds run `wrangler preview` (Worker Previews), which refuses to run without
  // this block. It is empty because an assets-only Worker has no bindings or vars to
  // point at staging. Preview URLs are <preview>-safe-unfollow.<subdomain>.workers.dev,
  // so the workers.dev noindex rule in _headers covers them, and Cloudflare adds
  // X-Robots-Tag: noindex to workers.dev Preview URLs on its own.
  "previews": {},
  // Off: an assets-only Worker runs no code, so there is nothing to observe, and request
  // logs would hold full URLs, including a checkout return's query string (GH#312).
  "observability": { "enabled": false },
}
