{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable"],
    // ES2022.Error is the `cause` option on the Error constructor and nothing else — the
    // narrowest lib that types `new Error(msg, { cause })`. `target` stays ES2020, so no
    // emit changes; this is types-only. A runtime without `cause` ignores the second
    // argument rather than throwing, so the degradation is silent and safe.
    "module": "ESNext",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./src/__tests__/*"]
    },
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/__tests__/**/*",
    "node_modules",
    "dist",
    "coverage"
  ]
}
