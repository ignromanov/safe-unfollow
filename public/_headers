# Cloudflare Workers static-assets header rules (developers.cloudflare.com/workers/static-assets/headers/).
# A request matching several rules gets the headers of all of them. Limit: 100 rules.
#
# Read by scripts/static-config.ts: the X-Robots-Tag rules below decide which routes the
# sitemap omits and which prerendered pages carry <meta name="robots" content="noindex">.
# Locale rules are spelled out per language (no regex groups here); a test checks each
# list against SUPPORTED_LANGUAGES.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://m.safeunfollow.app https://pagead2.googlesyndication.com https://*.googlesyndication.com https://fundingchoicesmessages.google.com https://*.adtrafficquality.google https://tally.so; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://m.safeunfollow.app https://live.dodopayments.com https://test.dodopayments.com https://*.doubleclick.net https://*.googlesyndication.com https://*.adtrafficquality.google https://fundingchoicesmessages.google.com; frame-src 'self' https://*.doubleclick.net https://*.googlesyndication.com https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://www.google.com https://tally.so; frame-ancestors https://m.safeunfollow.app; base-uri 'self'; form-action 'self'

# The worker's own workers.dev host and its preview URLs are copies of the site.
https://:name.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/wizard/step-*
  Cache-Control: public, max-age=2592000

