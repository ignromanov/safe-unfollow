# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
coverage/
# The bare "build/" rule above also catches src/__tests__/build/, which is a
# test suite name, not a build artifact — un-ignore it explicitly.
!src/__tests__/build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/
.cursor/
.idea/
*.swp
*.swo
*~

# Claude Code (keep configuration, ignore sensitive data)
CLAUDE.md
.claude
.claude/.env
.claude/cache/
.claude/logs/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Deployment
.vercel/
.netlify/

# Vite cache
.vite/

# TypeScript
*.tsbuildinfo

# Testing
coverage/
.nyc_output
# Compiled test files (Vitest should only run .ts/.tsx sources)
src/**/*.test.js
src/**/*.spec.js
src/__tests__/**/*.js

# Local development data (keep raw/ for development)
raw/

# Design folders (experimental designs) — ignore contents, not the dir, so the
# Claude Design backup can be tracked without -f (it was force-added before).
designs/*
!designs/claude-design-project/

# Scripts folders (ignore contents, not the dir — so specific files can be un-ignored)
scripts/*

# Serena cache
.serena

# AI artifacts (separate private repo)
.ai/

# Conclave advisor instance (symlink into the conclave repo)
.conclave

# Local Umami DB backups (never commit — contains analytics data)
umami-backup-*.sql.gz

# Retention script must ship despite the scripts/ ignore above (CI runs it)
!scripts/umami-retention.sql

# Entry-bundle budget guard must ship despite the scripts/ ignore above (npm run perf:budget)
!scripts/assert-entry-budget.mjs

# design-sync working state — the converter, the generated bundle and the machine
# caches a resync leaves behind. ~60 MB at repo root, untracked on every branch but
# chore/design-sync-main, which is one `git add -A` away from a commit. Matches the
# block that branch already carries, so the two do not disagree.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
# No trailing slash: this one is a symlink to ../.ds-sync/node_modules, and git
# classifies a symlink as a blob — a directory-only pattern never matches it.
.design-sync/node_modules
