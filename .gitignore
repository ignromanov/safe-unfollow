.cache/

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Deployment
.vercel/
.netlify/

# Vite cache
.vite/

# TypeScript
*.tsbuildinfo

# Testing
coverage/
.nyc_output
# Compiled test files (Vitest should only run .ts/.tsx sources)
src/**/*.test.js
src/**/*.spec.js
src/__tests__/**/*.js

# Local development data (keep raw/ for development)
raw/

# Design folders (experimental designs) — ignore contents, not the dir, so the
# Claude Design backup can be tracked without -f (it was force-added before).
designs/*
!designs/claude-design-project/

# Scripts folders (ignore contents, not the dir — so specific files can be un-ignored)
scripts/*

# Serena cache
.serena

# AI artifacts (separate private repo)
.ai/

# Conclave advisor instance (symlink into the conclave repo)
.conclave

# Local Umami DB backups (never commit — contains analytics data)
umami-backup-*.sql.gz

# Retention script must ship despite the scripts/ ignore above (CI runs it)
!scripts/umami-retention.sql

# Entry-bundle budget guard must ship despite the scripts/ ignore above (npm run perf:budget)
!scripts/assert-entry-budget.mjs

# Large-archive fixture generator must ship despite the scripts/ ignore above (PR #80)
!scripts/generate-large-archive.ts

# noindex-routes derivation must ship despite the scripts/ ignore above — generate-sitemap.ts
# imports it, and src/__tests__/scripts/noindex-routes.test.ts imports it directly
!scripts/noindex-routes.ts

# design-sync working state — the converter, the generated bundle and the machine
# caches a resync leaves behind, ~60 MB at repo root. All of it is DERIVED:
# `.design-sync/tools/preflight.sh` rebuilds every path below from scratch.
#
# Nothing hand-authored may live here. On 2026-08-20 three hand-written files did
# (compile-css.mjs and two .cache/ configs) and `git worktree remove` destroyed
# them with no warning it could have given — git does not track what it ignores.
# Hand-authored input belongs in the committed .design-sync/{tools,previews,overrides}/.
#
# No trailing slashes below, deliberately. Git classifies a symlink as a blob, so a
# directory-only pattern (`foo/`) never matches one — the same defect as the root
# `node_modules` rule on line 2. It matters most for exactly the change someone is
# most likely to try next: symlinking these into a worktree instead of running the
# sync from the main checkout. With a slash, that symlink is not ignored and
# `git add -A` stages 47 MB of converter.
.ds-sync
ds-bundle
.design-sync/.cache
.design-sync/learnings
# Symlink to ../.ds-sync/node_modules, needed by .design-sync/overrides/dts.mjs.
.design-sync/node_modules

# Agent scratch directories at the repo root. None of these was ignored before
# 2026-09-04, so all three sat in `git status` as untracked — which is precisely
# the configuration the "name the files, never `git add -A`" rule exists to
# survive, loaded three times over. No trailing slashes, for the reason stated
# in the design-sync block above: git classifies a symlink as a blob, so a
# directory-only pattern never matches one.
#   worktrees/ — `git worktree` checkouts, per the global convention. Note the
#                sibling `.worktrees` in .prettierignore: the measured 2026-08-19
#                defence covers the dotted name and not the one the convention
#                actually creates.
#   .design/   — DesignSync output (16 files under .design/tally-prompt/ made
#                `prettier --check .` exit 1 from a clean checkout).
#   .cmux/     — terminal-multiplexer session state.
worktrees
.design
.cmux
