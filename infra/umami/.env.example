# Copy to .env on the VPS (`cp .env.example .env && chmod 600 .env`) and fill in.
# .env is git-ignored; never commit it.

# --- Umami ------------------------------------------------------------------

# Exact version the Vercel instance runs (dashboard → profile menu → About).
# Must match during migration; see docker-compose.yml.
UMAMI_VERSION=

# Copy APP_SECRET from the Vercel project's environment variables.
# If Vercel has none, Umami was deriving its secret from DATABASE_URL — paste
# the old Supabase DATABASE_URL here verbatim to keep logins, share links and
# in-flight visitor tokens valid across the move. Otherwise: openssl rand -hex 32
APP_SECRET=

# Copy from Vercel if set there; leave empty otherwise.
# 64 hex chars (openssl rand -hex 32). Required before anyone can enable 2FA.
TWO_FACTOR_ENCRYPTION_KEY=

# The live instance reports trackerScriptName "su.js" (GET /api/config).
# Copy COLLECT_API_ENDPOINT from Vercel too if it is set there.
TRACKER_SCRIPT_NAME=su.js
COLLECT_API_ENDPOINT=

# --- Local Postgres ----------------------------------------------------------

# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Cloudflare --------------------------------------------------------------

# Zero Trust → Networks → Tunnels → Create (cloudflared) → the token from the
# "docker run" install command.
CLOUDFLARE_TUNNEL_TOKEN=

# R2 bucket for nightly dumps (bin/backup.sh). Token: R2 → Manage API tokens,
# "Object Read & Write" scoped to this bucket only.
R2_ACCOUNT_ID=
R2_BUCKET=safeunfollow-umami-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Data retention ------------------------------------------------------------

# Days of analytics kept by bin/retention.sh. 90 matches the policy the
# Supabase-era GitHub workflow enforced; the VPS disk has room for far more.
RETENTION_DAYS=90

# --- Migration only (remove after cutover) -----------------------------------

# Supabase → Connect → "Session pooler" URI (port 5432, IPv4-compatible).
# Not the transaction pooler on 6543: pg_dump needs a session.
SOURCE_DATABASE_URL=
